{
  "name": "ponto-pan",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace @ponto-pan/api\" \"npm run dev --workspace @ponto-pan/web\"",
    "build": "npm run build --workspace @ponto-pan/api && npm run build --workspace @ponto-pan/web",
    "typecheck": "npm run typecheck --workspace @ponto-pan/api && npm run typecheck --workspace @ponto-pan/web",
    "test": "npm run test --workspace @ponto-pan/api",
    "lint": "eslint apps eslint.config.js",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"*.json\" \"*.md\" eslint.config.js",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"*.json\" \"*.md\" eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fastify": "^5.12.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
